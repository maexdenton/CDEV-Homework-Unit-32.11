{
  // Настройка строки подключения к SQL Server Express
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=BlogPlatformDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AppName": "Блог-платформа (Production)",
  // В боевом окружении оставляем только логи уровня Warning и Error для максимальной производительности
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "*"
}