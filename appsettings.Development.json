{
  "AppName": "Блог-платформа (Dev Environment)",
  // В режиме разработки переопределяем логирование на более подробное (Information)
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Отключаем спам SQL-запросов EF Core в консоли
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"

      // Настройка уровней логирования для нашего LoggingMiddleware:
      //"WebApplication1.Middleware.LoggingMiddleware": "Warning"
    }
  }
}