@model IEnumerable<BlogPlatform.Models.DB.Feedback>

@{
    ViewData["Title"] = "Отзывы";
}

<div class="container my-4">
    <h2 class="mb-4">Обратная связь и отзывы</h2>

    <!-- Форма для отправки отзыва -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">Оставить отзыв</h5>
            <form id="feedbackForm">
                <div class="mb-3">
                    <label for="fromUser" class="form-label">Ваше имя</label>
                    <input type="text" id="fromUser" class="form-control" placeholder="Введите имя..." required />
                </div>
                <div class="mb-3">
                    <label for="feedbackText" class="form-label">Текст отзыва</label>
                    <textarea id="feedbackText" class="form-control" rows="3" placeholder="Напишите ваш отзыв..." required></textarea>
                </div>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    Отправить отзыв
                </button>
            </form>
        </div>
    </div>

    <h3 class="mb-3">Список отзывов</h3>

    <!-- Контейнер, куда динамически будут добавляться отзывы -->
    <div id="feedbackList">
        @foreach (var item in Model)
        {
            <div class="card mb-3 feedback-card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="card-subtitle text-primary fw-bold">@item.FromUser</h6>
                        <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</small>
                    </div>
                    <p class="card-text mb-0">@item.Text</p>
                </div>
            </div>
        }
    </div>
</div>