@model IEnumerable<WebApplication1.Models.Feedback>

@{
    ViewData["Title"] = "Отзывы";
}

<div class="container my-4">
    <h2 class="mb-4">Обратная связь и отзывы</h2>

    <!-- Форма для отправки отзыва -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Оставить отзыв</h5>
            <form id="feedbackForm">
                <div class="mb-3">
                    <label for="fromUser" class="form-label">Ваше имя</label>
                    <input type="text" id="fromUser" class="form-control" placeholder="Введите имя..." required />
                </div>
                <div class="mb-3">
                    <label for="feedbackText" class="form-label">Текст отзыва</label>
                    <textarea id="feedbackText" class="form-control" rows="3" placeholder="Напишите ваш отзыв..." required></textarea>
                </div>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    Отправить отзыв
                </button>
            </form>
        </div>
    </div>

    <h3 class="mb-3">Список отзывов</h3>

    <!-- Контейнер, куда динамически будут добавляться отзывы -->
    <div id="feedbackList">
        @foreach (var item in Model)
        {
            <div class="card mb-3 border-left-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="card-subtitle text-primary fw-bold">@item.FromUser</h6>
                        <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</small>
                    </div>
                    <p class="card-text mb-0">@item.Text</p>
                </div>
            </div>
        }
    </div>
</div>

<!-- JavaScript для AJAX-отправки -->
@section Scripts {
    <script>
        document.getElementById('feedbackForm').addEventListener('submit', async function (e) {
            e.preventDefault(); // Предотвращаем стандартную отправку формы и перезагрузку страницы

            const submitBtn = document.getElementById('submitBtn');
            const fromUser = document.getElementById('fromUser').value.trim();
            const text = document.getElementById('feedbackText').value.trim();

            if (!fromUser || !text) return;

            // Запрещаем повторные клики на время запроса
            submitBtn.disabled = true;

            try {
                // Выполняем асинхронный HTTP POST-запрос на сервер
                const response = await fetch('/Feedback/Add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        fromUser: fromUser,
                        text: text
                    })
                });

                const result = await response.json();

                if (result.success) {
                    // Динамически создаем новый HTML-блок отзыва
                    const feedbackList = document.getElementById('feedbackList');
                    const newFeedbackCard = document.createElement('div');
                    newFeedbackCard.className = 'card mb-3 border-left-primary';
                    newFeedbackCard.innerHTML = `
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="card-subtitle text-primary fw-bold">${result.feedback.fromUser}</h6>
                                <small class="text-muted">${result.feedback.createdAt}</small>
                            </div>
                            <p class="card-text mb-0">${result.feedback.text}</p>
                        </div>
                    `;

                    // Вставляем новый отзыв в самый верх списка (без перезагрузки)
                    feedbackList.insertBefore(newFeedbackCard, feedbackList.firstChild);

                    // Очищаем поля формы
                    document.getElementById('fromUser').value = '';
                    document.getElementById('feedbackText').value = '';
                } else {
                    alert('Ошибка: ' + result.message);
                }
            } catch (error) {
                console.error('Ошибка при отправке AJAX:', error);
                alert('Произошла ошибка при отправке отзыва.');
            } finally {
                submitBtn.disabled = false;
            }
        });
    </script>
}
