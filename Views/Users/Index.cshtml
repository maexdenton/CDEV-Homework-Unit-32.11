@model IEnumerable<BlogPlatform.Models.DB.User>

@{
    ViewData["Title"] = "Авторы";
}

<div class="d-flex justify-content-between align-items-center my-4">
    <h1>Список пользователей</h1>
    <!-- Кнопка для перехода на форму регистрации -->
    <a asp-controller="Users" asp-action="Register" class="btn btn-primary">
        + Зарегистрировать пользователя
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Имя (UserName)</th>
                <th>Email</th>
                <th>О себе (Bio)</th>
                <th>Дата регистрации</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td><code>@user.Id</code></td>
                    <td><strong>@user.UserName</strong></td>
                    <td>@user.Email</td>
                    <td>@(string.IsNullOrEmpty(user.Bio) ? "—" : user.Bio)</td>
                    <td>@user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
