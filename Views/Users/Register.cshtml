@model BlogPlatform.Models.DB.User

@{
    ViewData["Title"] = "Регистрация пользователя";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6">
        <h2 class="mb-3">Регистрация нового пользователя</h2>

        <form asp-controller="Users" asp-action="Register" method="post">
            <div class="mb-3">
                <label asp-for="UserName" class="form-label">Имя пользователя / Никнейм</label>
                <input asp-for="UserName" class="form-control" required placeholder="Введите имя..." />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" required placeholder="name@example.com" />
            </div>

            <div class="mb-3">
                <label asp-for="Bio" class="form-label">О себе (Bio)</label>
                <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Краткая информация..."></textarea>
            </div>

            <button type="submit" class="btn btn-success w-100">Сохранить</button>
            <a asp-action="Index" class="btn btn-secondary w-100 mt-2">Отмена</a>
        </form>
    </div>
</div>
